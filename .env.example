# Collection / paths
COLLECTION_NAME=kb_auto
DATA_RAW_PATH=./data/raw

# Vector store — Qdrant. Embedded (local folder) by default; set QDRANT_URL
# to use a server instead, e.g. docker run -p 6333:6333 qdrant/qdrant
# Embedded mode locks the folder: one process at a time (stop the API
# before running ingest or eval).
QDRANT_PATH=./data/qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Ingestion / chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPARSE_MODEL=Qdrant/bm25

# Retrieval
# hybrid = dense + BM25 fused with RRF (exact identifiers like P0420 match);
# dense  = embeddings only, ranked by SEARCH_TYPE.
RETRIEVAL_MODE=hybrid
TOP_K=6
FETCH_K=30
MMR_LAMBDA=0.5
SEARCH_TYPE=mmr

# Cross-encoder reranking: score the FETCH_K candidates against the
# question, keep the best TOP_K. Multilingual, CPU, ~2 s per question.
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Share of TOP_K reserved for chunks matching the request language.
# 0.67 with TOP_K=6 means 4 same-language slots + 2 open to any language,
# so cross-language content (e.g. an English-only code table) stays
# reachable from a French question. Set 0.0 to disable language bias.
LANGUAGE_PREF_RATIO=0.67

# LLM
LLM_MODEL=mistral:7b-instruct
OLLAMA_URL=http://localhost:11434
TEMPERATURE=0.1
MAX_TOKENS=512
LLM_TIMEOUT_S=60

# Evaluation — RAGAS judge (a different, larger local model)
RAGAS_JUDGE_MODEL=qwen2.5:14b
RAGAS_JUDGE_NUM_CTX=8192
RAGAS_JUDGE_TIMEOUT_S=600

# API
CORS_ORIGINS=["http://localhost:3000"]
API_HOST=0.0.0.0
API_PORT=8000

# Domain
ASSISTANT_PERSONA=automotive repair and maintenance
