# Collection / paths
COLLECTION_NAME=kb_auto
DATA_RAW_PATH=./data/raw
CHROMA_PATH=./data/chroma

# Ingestion / chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Retrieval
TOP_K=6
FETCH_K=30
MMR_LAMBDA=0.5
SEARCH_TYPE=mmr

# Share of TOP_K reserved for chunks matching the request language.
# 0.67 with TOP_K=6 means 4 same-language slots + 2 open to any language,
# so cross-language content (e.g. an English-only code table) stays
# reachable from a French question. Set 0.0 to disable language bias.
LANGUAGE_PREF_RATIO=0.67

# LLM
LLM_MODEL=mistral:7b-instruct
OLLAMA_URL=http://localhost:11434
TEMPERATURE=0.1
MAX_TOKENS=512
LLM_TIMEOUT_S=60

# API
CORS_ORIGINS=["http://localhost:3000"]
API_HOST=0.0.0.0
API_PORT=8000

# Domain
ASSISTANT_PERSONA=automotive repair and maintenance
